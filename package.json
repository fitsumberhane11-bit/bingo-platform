{
  "name": "bingo-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Production-grade real-money multiplayer Bingo platform for Ethiopia (Telebirr / CBE).",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:realtime": "pnpm --filter realtime dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @bingo/db generate",
    "db:validate": "pnpm --filter @bingo/db validate",
    "db:format": "pnpm --filter @bingo/db format",
    "db:migrate:dev": "pnpm --filter @bingo/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @bingo/db migrate:deploy",
    "db:seed": "pnpm --filter @bingo/db seed",
    "db:integrity-check": "pnpm --filter @bingo/db integrity-check"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "prettier": "3.3.3"
  }
}
