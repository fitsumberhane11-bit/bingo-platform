# ============================================================================
# Bingo Platform — Environment Variables
# Copy to .env (root) for local dev with docker-compose, or into each
# deployment target's secret manager. NEVER commit a real .env file.
# ============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Ethiopia Bingo"

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://bingo:bingo_dev_password@localhost:5432/bingo_dev

# --- Redis (game-event pub/sub, rate limiting, distributed locks) ----------
# If unset in development, the app falls back to an in-memory rate limiter
# AND an in-process game-event broadcaster (both single-process only — NOT
# safe for production, where REDIS_URL is required for multi-instance
# realtime fan-out to work at all; see docs/ARCHITECTURE.md §9).
# Zero-install local option: `pnpm --filter web dev:redis`.
REDIS_URL=redis://localhost:6379

# --- Auth ---------------------------------------------------------------------
# 32+ byte random secrets. Generate with: openssl rand -base64 48
AUTH_JWT_ACCESS_SECRET=CHANGE_ME_DEV_ONLY_ACCESS_SECRET_CHANGE_ME
AUTH_JWT_REFRESH_SECRET=CHANGE_ME_DEV_ONLY_REFRESH_SECRET_CHANGE_ME
AUTH_JWT_ACCESS_TTL_SECONDS=900
AUTH_JWT_REFRESH_TTL_SECONDS=2592000
# Encrypts twoFactorSecret and Game.secretSeedEncrypted at rest (32-byte key, base64)
APP_ENCRYPTION_KEY=CHANGE_ME_DEV_ONLY_32_BYTE_KEY_BASE64

# --- Email (SMTP) -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Ethiopia Bingo <no-reply@example.com>"
SMTP_SECURE=false

# --- SMS ------------------------------------------------------------------------
# Provider-agnostic. Leave as "mock" for development (OTPs are logged, not sent).
SMS_PROVIDER=mock

# --- Payments -------------------------------------------------------------------
# Global switch. MUST be "false" in any environment that isn't fully licensed,
# reviewed, and using verified production credentials. See docs/PRODUCTION_READINESS.md.
# NODE_ENV=production additionally hard-disables mock payments regardless of this flag.
ENABLE_MOCK_PAYMENTS=true
PAYMENTS_LIVE_MODE=false
# HMAC secret the mock provider uses to sign its simulated callbacks.
# Dev-only — never used once ENABLE_MOCK_PAYMENTS is false.
MOCK_PAYMENT_WEBHOOK_SECRET=CHANGE_ME_DEV_ONLY_MOCK_WEBHOOK_SECRET

# Telebirr — obtain from Telebirr merchant onboarding. Never commit real values.
# TELEBIRR_MODE must be explicitly "sandbox" or "production" for the adapter
# to consider itself configured at all — see docs/ARCHITECTURE.md and
# packages/payments/src/telebirr/telebirr-provider.ts (adapter structure is
# implemented; the actual request/response wiring is pending official docs).
TELEBIRR_MODE=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_NOTIFY_URL=${APP_URL}/api/payments/telebirr/callback
TELEBIRR_API_BASE_URL=

# CBE — placeholders only. PENDING OFFICIAL CBE MERCHANT/API SPECIFICATION —
# see packages/payments/src/cbe/cbe-provider.ts. Do not populate until that
# specification and merchant credentials exist.
CBE_API_URL=
CBE_MERCHANT_ID=
CBE_API_KEY=
CBE_SECRET=
CBE_NOTIFY_URL=${APP_URL}/api/payments/cbe/callback

# Chapa — NOT CONNECTED. placeholders only, see packages/payments/src/chapa/chapa-provider.ts.
CHAPA_API_URL=
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_NOTIFY_URL=${APP_URL}/api/payments/chapa/callback

# ArifPay — NOT CONNECTED. placeholders only, see packages/payments/src/arifpay/arifpay-provider.ts.
ARIFPAY_API_URL=
ARIFPAY_API_KEY=
ARIFPAY_NOTIFY_URL=${APP_URL}/api/payments/arifpay/callback

# M-Pesa (Ethiopia) — NOT CONNECTED. placeholders only, see packages/payments/src/mpesa/mpesa-provider.ts.
MPESA_API_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_NOTIFY_URL=${APP_URL}/api/payments/mpesa/callback

# --- Realtime service -----------------------------------------------------------
REALTIME_PORT=4000
REALTIME_INTERNAL_URL=http://localhost:4000

# --- Observability ----------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info
